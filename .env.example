# ==============================================================================
# BLIND BILLION 2.0 — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database Configuration
# Local SQLite fallback:
DATABASE_URL=sqlite:///data/multiplayer.db
# Production Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Analytical DuckDB Cache (Local read-only fast cache)
ANALYTICAL_DB_PATH=data/blindbillion.duckdb

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://blindbillion.app

# Server Port and Host
PORT=8000
HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO

# Rate Limiting Parameters (Optional Overrides)
RATE_LIMIT_CREATE_ROOM=10
RATE_LIMIT_JOIN_ROOM=30
